# Set these in the receiving host's environment; never commit actual values.
RTNSVP_API_KEY=replace-with-a-long-random-secret
RTNSVP_ALLOWED_ORIGINS=https://dashboard.example.com
OPENAI_API_KEY=replace-with-server-side-openai-key
OPENAI_MODEL=gpt-5.6-terra
# Optional resilience fallbacks; OpenAI remains the primary provider.
GEMINI_API_KEY=
GROQ_API_KEY=
# Free fallback: get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# Build-time frontend variables (set in frontend/.env.local):
# VITE_API_URL=wss://receiver.example.com
# VITE_API_TOKEN=same-value-as-RTNSVP_API_KEY
